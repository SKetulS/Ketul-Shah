{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image_1",
      "label": "First Banner Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image_2",
      "label": "Second Banner Image"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Bar Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "url",
      "id": "shop_now_link",
      "label": "Shop Now Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<section class="custom-banner">
  <div class="announcement-bar">
    <p>{{ section.settings.announcement_text }}</p>
  </div>

  <div class="banner-container">
    <img src="{{ section.settings.banner_image_1 | img_url: 'master' }}" class="banner-image active">
    <img src="{{ section.settings.banner_image_2 | img_url: 'master' }}" class="banner-image">
    
    <div class="banner-overlay">
      <h1>{{ section.settings.title }}</h1>
      <p>{{ section.settings.subtitle }}</p>
      <a href="{{ section.settings.shop_now_link }}" class="shop-button">Shop Now →</a>
    </div>
  </div>

  <a href="#" class="choose-gift">CHOOSE GIFT →</a>
</section>
