{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "banner_description",
      "label": "Banner Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<section class="custom-banner" style="background-image: url({{ section.settings.banner_image | img_url: 'master' }});">
  <div class="banner-content">
    <h1>{{ section.settings.banner_title }}</h1>
    <p>{{ section.settings.banner_description }}</p>
    <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_text }}</a>
  </div>
</section>

<style>
.custom-banner {
  background-size: cover;
  text-align: center;
  padding: 100px 20px;
  color: white;
}
.btn {
  background-color: black;
  color: white;
  padding: 10px 20px;
  display: inline-block;
  transition: 0.3s ease-in-out;
}
.btn:hover {
  background-color: gray;
}
</style>
