<section class="custom-banner">
  <div class="banner-container">
    {% if section.settings.banner_image != blank %}
      <img src="{{ section.settings.banner_image | img_url: 'master' }}" alt="Banner Image" class="banner-image">
    {% endif %}
    <div class="banner-content">
      <h1 class="logo-text">{{ section.settings.logo_text }}</h1>
      <h2 class="headline">{{ section.settings.headline }}</h2>
      <p class="description">{{ section.settings.description }}</p>
      <a href="{{ section.settings.choose_gift_link }}" class="choose-gift-button">{{ section.settings.choose_gift_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Background Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "url",
      "id": "choose_gift_link",
      "label": "Choose Gift Button Link"
    },
    {
      "type": "text",
      "id": "choose_gift_text",
      "label": "Choose Gift Button Text",
      "default": "CHOOSE GIFT →"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}