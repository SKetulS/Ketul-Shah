<section class="product-grid">
  <h2 class="section-title">Tisso Vision in the Wild</h2>
  <div class="grid-container">
    {% for block in section.blocks %}
      {% assign product = all_products[block.settings.product] %}
      <div class="product-card">
        <div class="product-thumbnail" onclick="openProductPopup('{{ product.id }}')">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}" class="product-image">
          {% else %}
            <p>No Image Available</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<!-- Product Popup Modal -->
<div id="product-popup" class="popup">
  <div class="popup-content">
    <span class="close-popup" onclick="closeProductPopup()">&times;</span>
    <img id="popup-image" src="" alt="Product Image">
    <h3 id="popup-title"></h3>
    <p id="popup-price"></p>
    <p id="popup-description"></p>
    
    <label for="color">Color:</label>
    <div class="color-options" id="popup-colors"></div>

    <label for="size">Size:</label>
    <select id="popup-size"></select>

    <button class="add-to-cart" id="add-to-cart-btn">ADD TO CART →</button>
  </div>
</div>

{% schema %}
{
  "name": "Custom Grid",
  "settings": [],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Grid",
      "blocks": [
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
