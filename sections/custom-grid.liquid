{% schema %}
{
  "name": "Custom Grid",
  "settings": [
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Product 4"
    },
    {
      "type": "product",
      "id": "product_5",
      "label": "Product 5"
    },
    {
      "type": "product",
      "id": "product_6",
      "label": "Product 6"
    }
  ],
  "presets": [
    {
      "name": "Custom Grid"
    }
  ]
}
{% endschema %}

<section class="custom-grid">
  <h2>Tisso Vision in the Wild</h2>
  <div class="grid-container">
    {% for i in (1..6) %}
      {% assign product = section.settings["product_" | append: i] %}
      {% if product %}
        <div class="grid-item" data-product-id="{{ product.variants.first.id }}">
          <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
          <button class="view-product">+</button>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<div id="product-popup" class="popup">
  <div class="popup-content">
    <span class="close">&times;</span>
    <div class="popup-details"></div>
    <button id="add-to-cart">ADD TO CART →</button>
  </div>
</div>
